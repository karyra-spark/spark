{
  "name": "karyra-spark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node build",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "audit:public-copy": "node src/scripts/audit-public-copy-contract.mjs",
    "audit:microcopy": "node src/scripts/audit-public-microcopy.mjs",
    "audit:journey-copy": "node src/scripts/audit-journey-copy.mjs",
    "audit:learning-flow": "node src/scripts/audit-learning-flow.mjs",
    "audit:passport": "node src/scripts/audit-passport-explainability.mjs",
    "audit:css-syntax": "node src/scripts/audit-css-global-selectors.mjs",
    "audit:hub-topology": "node src/scripts/audit-hub-topology.mjs",
    "audit:desktop-layout": "node src/scripts/audit-desktop-layout.mjs",
    "audit:beta-signal": "node src/scripts/audit-beta-signal.mjs",
    "audit:code-clean": "node src/scripts/audit-code-cleanliness.mjs",
    "audit:all": "pnpm run audit:code-clean && pnpm run audit:public-copy && pnpm run audit:microcopy && pnpm run audit:journey-copy && pnpm run audit:learning-flow && pnpm run audit:passport && pnpm run audit:css-syntax && pnpm run audit:hub-topology && pnpm run audit:desktop-layout && pnpm run audit:beta-signal && pnpm run audit:repo-hygiene",
    "audit:public-repo": "pnpm run audit:repo-hygiene",
    "audit:repo-hygiene": "node src/scripts/audit-repository-hygiene.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "latest",
    "bits-ui": "latest",
    "clsx": "latest",
    "mode-watcher": "latest",
    "svelte-sonner": "latest",
    "tailwind-merge": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.4",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.7"
  },
  "packageManager": "pnpm@10.0.0",
  "description": "Public SvelteKit frontend for Karyra Spark, a local-first Starknet readiness gateway."
}
