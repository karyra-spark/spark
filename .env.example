# Karyra Spark public frontend configuration.
# This file is safe to commit. Copy to .env for local development.

PUBLIC_SPARK_APP_NAME="Karyra Spark"
PUBLIC_SPARK_MODE="beta"

# Local frontend URL. Change only for your own local or preview environment.
PUBLIC_SPARK_APP_URL="http://localhost:5173"

# Local backend URL. Production/staging is configured by deployment environment.
PUBLIC_SPARK_API_URL="http://localhost:8787"

# One-domain beta topology: Hub is served under the same domain at /hub.
PUBLIC_SPARK_HUB_URL="/hub"

# Optional local separate Hub development:
# PUBLIC_SPARK_HUB_URL="http://localhost:5174"
